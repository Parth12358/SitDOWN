{
  "name": "sitdown",
  "private": true,
  "version": "0.0.0",
  "description": "SitDOWN — turns every coding-agent session and commit into living, linked Markdown documentation that people and agents can query.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "fixtures:events": "node contracts/make-events-sqlite.mjs",
    "demo-reset": "node scripts/demo-reset.mjs",
    "demo:seed": "node demo/seed.mjs",
    "demo:serve": "node demo/serve.mjs",
    "demo:test": "node demo/live-test.mjs",
    "demo:showcase": "node demo/showcase.mjs",
    "demo": "pnpm -s build && node demo/seed.mjs && node demo/serve.mjs"
  }
}
