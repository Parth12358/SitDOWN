# SitDOWN — secrets come from the environment only. Never commit real keys.
# Copy to .env (git-ignored) and fill in as needed.

# Cloud LLM for the summarizer (PRD B). Omit when llm: "ollama".
LLM_API_KEY=

# Keewano event store (PRD C, D). Omit when event_store: "sqlite".
KEEWANO_API_KEY=
KEEWANO_PAT=

# Dial voice + SMS (PRD E).
DIAL_API_KEY=

# MCP HTTP server port (PRD D). Defaults to 7331.
MCP_HTTP_PORT=7331
