{
  "name": "@sitdown/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "D: MCP query server (stdio + HTTP) over the vault and event store.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sitdown-mcp": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sitdown/contracts": "workspace:*",
    "@sitdown/vault": "workspace:*",
    "sql.js": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.9"
  }
}
